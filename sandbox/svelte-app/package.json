{
  "name": "chai-sandbox-svelte",
  "version": "0.0.0",
  "private": true,
  "description": "The SvelteKit part of the packaging smoke test (see ../consumer-app/README.md). Installs @chai-ui/svelte from the tarballs ../../scripts/pack-test.sh packs into ../consumer-app/.tarballs, with npm, not pnpm, and builds with server rendering.",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5192",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && vite build",
    "start": "node build"
  },
  "dependencies": {
    "@chai-ui/svelte": "file:../consumer-app/.tarballs/chai-ui-svelte.tgz"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@chai-ui/core": "file:../consumer-app/.tarballs/chai-ui-core.tgz",
    "@chai-ui/tokens": "file:../consumer-app/.tarballs/chai-ui-tokens.tgz"
  }
}
