{
  "name": "chai-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Chai UI: drop-in React components for generative-AI apps.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "pack-test": "./scripts/pack-test.sh",
    "clean": "turbo run clean && rimraf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm test && pnpm lint && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
