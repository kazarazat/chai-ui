{
  "name": "@chai-ui/svelte",
  "version": "0.14.1",
  "private": true,
  "description": "Chai UI Svelte components — smart, drop-in UI for AI apps: Composer, Media Analyzer, Result Card, Edit Card, and the useComposer hook.",
  "license": "MIT",
  "author": "kazarazat",
  "homepage": "https://chai-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazarazat/chai-ui.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/kazarazat/chai-ui/issues"
  },
  "keywords": [
    "chai-ui",
    "ai",
    "generative-ai",
    "design-system",
    "ai-ui",
    "svelte",
    "sveltekit",
    "components",
    "prompt",
    "composer"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/__tests__",
    "DESIGN.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rimraf dist && svelte-package -i src -o dist && node -e \"require('fs').copyFileSync('../react/src/style.css','dist/style.css');require('fs').copyFileSync('../react/DESIGN.md','DESIGN.md')\"",
    "dev": "svelte-package -i src -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "echo \"(no lint configured yet)\"",
    "clean": "rimraf dist",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage/unit && vitest run --config vitest.browser.config.ts --coverage --coverage.reporter=lcov --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage/browser",
    "test:unit": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "svelte": "^5.16.0"
  },
  "dependencies": {
    "@chai-ui/core": "workspace:*",
    "@chai-ui/tokens": "workspace:*",
    "@fontsource/roboto": "^5.3.0",
    "@material/web": "^2.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "rimraf": "^6.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vitest-browser-svelte": "^1.1.0"
  }
}
