      "standard": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "growth": {
        "$value": "cubic-bezier(0.34, 1.2, 0.64, 1)",
        "$description": "Slight overshoot — for content arriving, e.g. a result appearing"
      }
    }
