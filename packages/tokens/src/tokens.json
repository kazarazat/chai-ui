    "semantic": {
      "$description": "What components actually reference. Never point a component at color.root directly.",
      "text-on-accent": {
        "$value": "{color.root.gray-100}"
      },
      "accent": {
        "$value": "{color.root.green-50}",
        "$description": "Fills, switches, icons, focus rings. 3.8:1 on white: not for small text."
      },
      "accent-hover": {
        "$value": "{color.root.green-40}"
      },
      "accent-subtle": {
        "$value": "{color.root.green-95}"
      },
      "accent-soft": {
        "$value": "{color.root.green-80}",
        "$description": "The bright mint: the ready submit button, an open picker, a drop zone with a file dragged over it"
      },
      "accent-text": {
        "$value": "{color.root.green-40}",
        "$description": "Green text and small icons on light backgrounds (6.5:1 on white)"
      },
      "warning": {
        "$value": "{color.root.amber-50}"
      },
      "warning-subtle": {
        "$value": "{color.root.amber-80}"
      },
      "danger": {
        "$value": "{color.root.red-50}"
      },
      "danger-subtle": {
        "$value": "{color.root.red-80}"
      },
      "control-surface": {
        "$value": "{color.root.gray-97}",
        "$description": "Input and card fill: the Composer bar, Media Analyzer, result card media area"
      },
      "control-surface-hover": {
        "$value": "{color.root.gray-90}",
        "$description": "Hover and pressed fill for buttons, menu items and chips"
      },
      "control-surface-raised": {
        "$value": "{color.root.gray-100}",
        "$description": "Menus, the result card info side, and the hover fill of controls floating on media"
      },
      "control-track": {
        "$value": "{color.root.gray-85}",
        "$description": "Switch track, video scrubber track"
      },
      "control-divider": {
        "$value": "{color.root.gray-85}",
        "$description": "Thin dividers and thumbnail borders"
      },
      "control-border": {
        "$value": "{color.root.gray-50}",
        "$description": "Borders of inputs, chips and outlined buttons"
      },
      "control-border-soft": {
        "$value": "{color.root.gray-60}",
        "$description": "Card outlines and the switch outline"
      },
      "control-border-faint": {
        "$value": "{color.root.gray-75}"
      },
      "control-text-strong": {
        "$value": "{color.root.gray-10}",
        "$description": "Menu and option text"
      },
      "control-text": {
        "$value": "{color.root.gray-30}",
        "$description": "Text typed into controls, chip text"
      },
      "control-text-muted": {
        "$value": "{color.root.gray-40}",
        "$description": "Icons, placeholders, switch handle (5.4:1 on control-surface)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.5)",
        "$description": "Buttons sitting on top of media: play, collapse, remove"
      },
      "on-overlay": {
        "$value": "{color.root.gray-100}",
        "$description": "Icons on overlay buttons"
      },
      "overlay-light": {
        "$value": "rgba(255, 255, 255, 0.5)",
        "$description": "Light buttons sitting on top of media, with dark text: the edit card's region chips"
      },
      "scrim": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Backdrop behind an expanded image or video"
      },
      "media-backdrop": {
        "$value": "{color.root.gray-0}",
        "$description": "Letterboxing behind video, and the strip below paginated media"
      },
      "on-media-fade": {
        "$value": "{color.root.gray-80}",
        "$description": "Text on the dark fade at the bottom of media: the result card's model label"
      },
      "region-1": {
        "$value": "{color.root.cyan-40}",
        "$description": "Region colors, in order: the box, badge and Composer chip of each marked area in an image edit. White text on each is at least 4.7:1."
      },
      "region-2": {
        "$value": "{color.root.magenta-40}"
      },
      "region-3": {
        "$value": "{color.root.orange-40}"
      },
      "region-4": {
        "$value": "{color.root.blue-40}"
      },
      "region-5": {
        "$value": "{color.root.violet-40}"
      },
      "region-6": {
        "$value": "{color.root.red-40}"
      }
    },
    "material": {
      "$description": "The Material Design 3 color roles the @material/web components Chai renders (switch, submit button, outlined text field) read. Each points at a Chai token, and the build emits them as --md-sys-color-* variables that reference those tokens, so Chai is the single source and Material follows it.",
      "primary": {
        "$value": "{color.semantic.accent}"
      },
      "on-primary": {
        "$value": "{color.semantic.control-surface-raised}"
      },
      "primary-container": {
        "$value": "{color.semantic.accent-soft}"
      },
      "on-primary-container": {
        "$value": "{color.semantic.accent-text}"
      },
      "secondary": {
        "$value": "{color.semantic.accent}"
      },
      "secondary-container": {
        "$value": "{color.semantic.accent-soft}"
      },
      "on-secondary-container": {
        "$value": "{color.semantic.accent-text}"
      },
      "tertiary-container": {
        "$value": "{color.semantic.accent-soft}"
      },
      "on-tertiary-container": {
        "$value": "{color.semantic.accent-text}"
      },
      "error": {
        "$value": "{color.semantic.danger}"
      },
      "on-error-container": {
        "$value": "{color.semantic.danger}"
      },
      "surface": {
        "$value": "{color.semantic.control-surface-raised}"
      },
      "surface-container-low": {
        "$value": "{color.semantic.control-surface}"
      },
      "surface-container-high": {
        "$value": "{color.semantic.control-surface-hover}"
      },
      "surface-container-highest": {
        "$value": "{color.semantic.control-track}"
      },
      "on-surface": {
        "$value": "{color.semantic.control-text-strong}"
      },
      "on-surface-variant": {
        "$value": "{color.semantic.control-text}"
      },
      "outline": {
        "$value": "{color.semantic.control-border}"
      },
      "shadow": {
        "$value": "{color.semantic.media-backdrop}"
      }
    }
  },
