  "shadow": {
    "menu": {
      "$value": "0px 1px 2px 0px rgba(0, 0, 0, 0.3), 0px 2px 6px 2px rgba(0, 0, 0, 0.15)",
      "$description": "Floating menus and popovers"
    }
  },
  "gradient": {
    "ai": {
      "$value": "linear-gradient(90deg, #7b6fd6, #e08d75, #afc9f2, #7b6fd6)",
      "$description": "The AI shimmer: text revealing after prompt optimization"
    },
    "media-fade": {
      "$value": "linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--chai-color-semantic-media-backdrop) 8%, transparent) 30%, color-mix(in srgb, var(--chai-color-semantic-media-backdrop) 30%, transparent) 60%, color-mix(in srgb, var(--chai-color-semantic-media-backdrop) 70%, transparent) 85%, var(--chai-color-semantic-media-backdrop) 100%)",
      "$description": "Fades the bottom of paginated media into the media-backdrop strip, so the model label and page dots read over any image. Built from media-backdrop: change that one token and the fade and the strip change together, with no seam. Eased: light most of the way, full strength only at the strip."
    }
  }
